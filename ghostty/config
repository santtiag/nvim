auto-update = download
# theme = TokyoNight Night
theme = Kanagawa Wave
font-family = "Iosevka Nerd Font Medium"
font-feature = +liga
font-feature = +calt
font-size = 12

gtk-titlebar = false
window-theme = ghostty
window-show-tab-bar = auto
window-width = 170
window-height = 45

# background-opacity = 0.9
background-blur = true
scrollbar = never

copy-on-select = clipboard
custom-shader = shaders/cursor_smear.glsl
custom-shader-animation = true
split-divider-color = white

bold-is-bright = true
initial-command = ~/.local/bin/herdr

# -- Keybindings --
# keybind = clear
keybind = alt+enter=toggle_maximize
keybind = alt+x=close_surface
keybind = alt+o=toggle_tab_overview
keybind = ctrl+shift+t=new_tab

