# Standalone Ghostty profile for the idle screensaver.
# --config-default-files=false keeps herdr / shaders out of this window.
class = org.cachyos.screensaver
gtk-single-instance = false
gtk-titlebar = false
window-theme = ghostty
window-decoration = false
confirm-close-surface = false
clipboard-read = allow
clipboard-write = allow

font-family = Iosevka Nerd Font Medium
font-size = 14

background = #000000
foreground = #c8c8c8
background-opacity = 1
background-blur = false
window-padding-x = 0
window-padding-y = 0
cursor-opacity = 0
scrollbar = never
mouse-hide-while-typing = true
